# Copy to .env and fill in from the Firebase console: Project settings > General > Your apps > Web app.
# Without these, the "Continue with Google" button is hidden. Vite reads them when the dev server or a build starts.
# The server needs the same project id: Firebase:ProjectId (user-secrets locally, Firebase__ProjectId in production).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
