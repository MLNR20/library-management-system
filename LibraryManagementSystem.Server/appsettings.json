{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" }
    ]
  },
  "Jwt": {
    "Issuer": "LibraryManagementSystem",
    "Audience": "LibraryManagementSystem.Client",
    "SigningKey": "",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 14
  },
  "Firebase": {
    "ProjectId": ""
  },
  "Email": {
    "Host": "",
    "Port": 587,
    "EnableSsl": true,
    "UserName": "",
    "Password": "",
    "FromAddress": "",
    "FromName": "Library"
  },
  "PasswordReset": {
    "ClientUrl": "",
    "TokenLifetimeMinutes": 60,
    "ResendCooldownSeconds": 60
  },
  "Borrowing": {
    "LoanPeriodDays": 14,
    "PenaltyPerDay": 1.00,
    "PenaltyCheckSeconds": 60
  },
  "Reminders": {
    "RunAt": "08:00",
    "TimeZoneId": "",
    "DueSoonDays": 2
  },
  "AllowedHosts": "*"
}
