{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" }
    ]
  },
  "Jwt": {
    "Issuer": "LibraryManagementSystem",
    "Audience": "LibraryManagementSystem.Client",
    "SigningKey": "",
    "AccessTokenMinutes": 60
  },
  "Borrowing": {
    "LoanPeriodDays": 14,
    "PenaltyPerDay": 1.00,
    "PenaltyCheckSeconds": 60
  },
  "AllowedHosts": "*"
}
